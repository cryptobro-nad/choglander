# Live voice and writing.
# CHOG_USE_LIVE=1 turns live on wherever a key is set. CHOG_USE_LIVE=0 (or CHOG_FORCE_MOCK=1) keeps it off.
# Left empty, live is on in production whenever a key is set, and off in dev and tests.
# Off means the hand-written bank and on-device speech: no credits are spent.
CHOG_USE_LIVE=
CHOG_FORCE_MOCK=

# OpenAI-compatible chat completions. Never commit the real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ElevenLabs. The server reads this; the browser never does.
# Also set a character quota on the key itself in the ElevenLabs dashboard as a backstop.
ELEVENLABS_API_KEY=
# The voice model, streamed from /v1/text-to-speech/{voice}/stream. Docs as of 18 Oct 2026:
#   eleven_v3 (default)  streams, and performs the writer's audio tags ([sarcastic], [sighs], ...),
#                        which were written for it. Slower to first audio than Flash (a larger model); the
#                        docs give no figure and steer real-time use to Flash or v4 Turbo.
#   eleven_v4            streams and performs the same tags; the docs call it a net upgrade on v3.
#                        No latency figure. Takes only stability and similarity, so the cast may sound
#                        different: audition it before switching.
#   eleven_flash_v2_5    fastest (~75 ms model time) but takes no audio tags: they are stripped before
#                        speech. A smaller model that trades some quality for speed.
#   eleven_v4_turbo      ~100 ms and takes tags, but the docs only offer it on the Text to Dialogue
#                        WebSocket, not on this HTTP endpoint. Untested here.
# Changing the model changes every cache key, so cached clips are not reused across models.
ELEVENLABS_MODEL=eleven_v3

# Signs the short-lived /api/voice tickets that /api/speak hands out (HMAC-SHA256, 10 minutes).
# Use 32 or more random characters, the same on every instance. Empty means a key derived one-way
# from ELEVENLABS_API_KEY, so rotating that key also voids any ticket in flight. Never sent to the client.
CHOG_VOICE_SECRET=

# Live Talk invites. With both TALK_PASS_SECRET and ELEVENLABS_API_KEY set, /api/talk hands out a
# short-lived line to an agent only to someone holding a pass (npm run pass -- --kind guest --name "Alex"),
# so the agents can be made private. With either missing, Talk stays public, as before.
# In production the key also turns on the live voice above; CHOG_USE_LIVE=0 keeps that off and Talk on.
# Use 32 or more random characters, the same here as in the deployment. Changing it voids every pass.
TALK_PASS_SECRET=
# Pass ids to refuse before they end, comma separated (the script prints each pass's id).
TALK_PASS_REVOKED=

# Daily budgets for the whole deploy (per-client and per-IP caps are in src/lib/limits.ts).
# A clip is one ElevenLabs call, counted when /api/voice starts it; a cached clip costs nothing.
CHOG_DAILY_CLIPS=400
CHOG_DAILY_LINES=1500

# Timeouts for the paid calls, in milliseconds. The AI writer stays under the app's 4 s wait for the
# caption. CHOG_TTS_TIMEOUT_MS is the wait for ElevenLabs' first audio byte; it stays under the app's
# 4 s wait for audio to start, so a slow clip comes back as an error and the device voice takes the line.
CHOG_LLM_TIMEOUT_MS=2500
CHOG_TTS_TIMEOUT_MS=3500

# Where the clip cache and usage book go. Defaults to the OS temp folder (writable on Vercel).
CHOG_DATA_DIR=

# Extra origins allowed to call /api/speak and play /api/voice, comma separated. The Android app's
# https://localhost, http://localhost and capacitor://localhost are always allowed.
CHOG_CORS_ORIGINS=

# Build-time, for the Android export: the deployed web origin the APK calls for lines and voice,
# for example https://choglander.vercel.app. Empty means the APK uses its own bank and device voice.
NEXT_PUBLIC_CHOG_API_ORIGIN=

# Build-time, for the Android export: the public site that shared cards link to
# (<site>/c/<art>/<line>, whose link preview on X is the card itself). Empty means the APK uses
# NEXT_PUBLIC_CHOG_API_ORIGIN; with neither, "Post to X" sends the card image through the phone's
# share sheet instead of a link. The web app always links to the address it is served from.
NEXT_PUBLIC_SITE_URL=

# Optional per-archetype voice overrides. Defaults (Voice Library actors) are in src/lib/voices.ts.
ELEVENLABS_VOICE_TOLD_YOU_SO=
ELEVENLABS_VOICE_HYPE=
ELEVENLABS_VOICE_GREMLIN=
ELEVENLABS_VOICE_PROFESSOR=
ELEVENLABS_VOICE_SOAP=
ELEVENLABS_VOICE_NIGHT=
ELEVENLABS_VOICE_GOLDEN=
ELEVENLABS_VOICE_ROOMMATE=
ELEVENLABS_VOICE_LEGEND=
