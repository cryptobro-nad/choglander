<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window before Android 12 (12+ uses the system splash set in styles.xml): the Chog on the
     page's periwinkle, centred and never stretched. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/chog_splash" />
    <item
        android:width="132dp"
        android:height="132dp"
        android:drawable="@mipmap/ic_launcher_round"
        android:gravity="center" />
</layer-list>
